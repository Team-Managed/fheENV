SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Hardhat deployment only. Do not use this variable for the production CLI.
PRIVATE_KEY=0xyour_deployer_private_key
NEXT_PUBLIC_REGISTRY_ADDRESS=0xb9a29d0Cfb402d91c6f70eF117758C118f00F5B2
# Required for bounded dashboard event queries; copy deployBlock from deployments/<network>.json
NEXT_PUBLIC_REGISTRY_DEPLOY_BLOCK=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Server-side only (used by /api/ipfs route — never exposed to browser)
PINATA_JWT=

# Development-only encrypted local signer unlock.
FHEENV_KEY_PASSPHRASE=

# Headless external signer executable, where the configured provider is "example".
# Must be an absolute path. Signer credentials stay inside the provider.
FHEENV_EXTERNAL_SIGNER_EXAMPLE=

# Optional exec:// secret provider. Values are resolved over bounded stdin/stdout JSON.
FHEENV_SECRET_PROVIDER_EXAMPLE=
FHEENV_SECRET_PROVIDER_EXAMPLE_ARGS=
FHEENV_SECRET_PROVIDER_EXAMPLE_ALLOW_ENV=

# Optional, explicit product analytics. CLI collection still requires user opt-in.
FHEENV_ANALYTICS_KEY=
FHEENV_ANALYTICS_HOST=https://us.i.posthog.com

# Optional anonymous frontend page views.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
